{
  "name": "@zytyan/ytyanbot-ts",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "imports": {
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@4.0.71",
    "ai": "npm:ai@7.0.127",
    "@ai-sdk/google": "npm:@ai-sdk/google@4.0.87",
    "@ai-sdk/deepseek": "npm:@ai-sdk/deepseek@3.0.58",
    "grammy": "npm:grammy@1.45.1/web",
    "@grammyjs/runner": "https://deno.land/x/grammy_runner@v2.0.3/mod.ts",
    "https://lib.deno.dev/x/grammy@v1/mod.ts": "npm:grammy@1.45.1/web",
    "https://lib.deno.dev/x/grammy@v1/types.ts": "npm:grammy@1.45.1/web/types",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/yaml": "jsr:@std/yaml@1.1.2",
    "zod": "npm:zod@4.4.3",
    "fraction.js": "npm:fraction.js@5.3.4"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check src/main.ts",
    "test:unit": "deno test --allow-sys=hostname tests/unit",
    "test:integration": "deno test --allow-sys=hostname --allow-read --allow-write --allow-env tests/integration",
    "test": "deno task test:unit && deno task test:integration",
    "compile": "deno compile --target x86_64-unknown-linux-gnu --output dist/ytyanbot-linux-x86_64 --allow-sys=hostname,inspector --allow-env=YTYAN_CONFIG_FILE,YTYAN_DATABASE_PATH,YTYAN_AI_MEDIA_PATH,YTYAN_BOT_TOKEN,GEMINI_API_KEY,CLIPROXYAPI_API_KEY,CLIPROXYAPI_BASE_URL,DEEPSEEK_API_KEY,TZ,BOT_INNER_HTTP,GOYTYAN_BACKUP_TOKEN,GOYTYAN_BACKUP_MAX_DURATION --allow-net --allow-read=/opt/tgbots/telegram-bot-api,/opt/tgbots/ytyanbot/src/assets,/opt/tgbots/ytyanbot/build,/opt/tgbots/ytyanbot/run,/tmp --allow-write=/opt/tgbots/ytyanbot/run,/tmp --include=src/assets --allow-run=/usr/bin/tar,/usr/bin/ffmpeg,/usr/local/bin/yt-dlp,/usr/bin/bbdown-go,/usr/bin/ffprobe src/main.ts",
    "db:generate": "deno run --allow-read=sql,src/db --allow-write=src/db --allow-run scripts/generate_sql.ts",
    "db:verify": "deno task db:generate --check"
  }
}
